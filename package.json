{
  "name": "aarohcare-backend",
  "version": "1.0.0",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "start:prod": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "audit:token-index": "tsx scripts/migrateAppointmentTokenIndex.ts --audit-only",
    "migrate:token-index": "tsx scripts/migrateAppointmentTokenIndex.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "AarohaCare multi-hospital appointment booking API",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1099.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cashfree-pg": "^6.0.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "razorpay": "^2.9.8",
    "socket.io": "^4.8.3",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "eslint": "^10.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.67.0"
  }
}
